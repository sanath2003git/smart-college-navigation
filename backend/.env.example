# SmartNav Backend Environment Configuration Example
# Copy this file to `backend/.env` and provide your actual local development values.
# NEVER commit the actual `.env` file or database credentials to version control.

# Django Core Settings
DJANGO_SECRET_KEY=django-insecure-replace-this-with-a-secure-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# MySQL 8.0 Database Configuration
DB_NAME=smartnav_dev
DB_USER=smartnav_user
DB_PASSWORD=your_secure_password_here
DB_HOST=127.0.0.1
DB_PORT=3306

# CORS Configuration (Vite local development server)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Clerk JWT Authentication (Backend)
# Obtain from Clerk Dashboard -> Configure -> API Keys / Domains
# Example issuer: https://clerk.your-domain.com or https://verb-noun-00.clerk.accounts.dev
CLERK_ISSUER=https://your-app.clerk.accounts.dev
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json

# Comma-separated allowlist of Clerk user IDs authorized for admin CRUD operations
# Example: user_2tQ...
CLERK_ADMIN_USER_IDS=user_replace_with_actual_clerk_admin_id

# Rate Limiting / Throttling (DRF)
DRF_THROTTLE_RATE_ANON=100/minute

# Example environment variables for the SmartNav backend.