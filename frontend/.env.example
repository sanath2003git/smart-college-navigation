# SmartNav Frontend Environment Configuration Example
# Copy this file to .env and replace placeholders with your actual configuration.

# Clerk Publishable Key (from Clerk Dashboard -> API Keys)
# Format: pk_test_... or pk_live_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# Django REST Backend API Base URL
# Default: http://127.0.0.1:8000 (no trailing slash)
VITE_API_BASE_URL=http://127.0.0.1:8000
